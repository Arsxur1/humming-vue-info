# AvatarStudio — локальная разработка.
# Скопируй в .env и при необходимости поменяй значения.
# Схема и валидация: packages/shared/src/env.ts

NODE_ENV=development

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (docker-compose)
DATABASE_URL=postgres://avatarstudio:avatarstudio@localhost:5432/avatarstudio

# Redis (docker-compose)
REDIS_URL=redis://localhost:6379

# S3 / MinIO (docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=avatarstudio
S3_SECRET_KEY=avatarstudio
S3_BUCKET=avatarstudio-dev

# Хранилище: s3 (MinIO из docker-compose) или fs (без docker)
STORAGE_DRIVER=fs
STORAGE_FS_DIR=.data/storage
API_PUBLIC_URL=http://localhost:3001

# Auth (в production ОБЯЗАТЕЛЬНО задать свой секрет — иначе api не стартует!)
# Сгенерировать: openssl rand -base64 48
# JWT_SECRET=change-me-in-production

# Почта (SMTP). Без SMTP_HOST письма пишутся в лог (dev-режим), не отправляются.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# SMTP_FROM=AvatarStudio <no-reply@yourdomain.com>

# Ограничение частоты запросов (false — отключить, например для нагрузочных тестов)
RATE_LIMIT_ENABLED=true

# 2FA: имя, отображаемое в приложении-аутентификаторе
TOTP_ISSUER=AvatarStudio
